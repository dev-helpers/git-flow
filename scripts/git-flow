#!/usr/bin/env bash
#
# See show_help above for more info
#
set -euo pipefail

show_help() {
	cat <<EOF
Usage:
  git feat <name> [--push]
  git fix <name> [--push]
  git hotfix <name> [--push]
  git sync [--push]
  git pr

Commands:
  feat        Create a feature branch from develop
  fix         Create a bugfix branch from develop
  hotfix      Create a hotfix branch from main
  sync        Rebase current branch onto its base branch
  pr          Open the PR creation page in Azure DevOps

Also supported (verbose equivalents):
  git feature <name> [--push]
  git bugfix <name> [--push]
  git flow <type/name> [--push]
  git propose
  git flow help

Notes:
  - Names with spaces must be quoted
  - Spaces in names are converted to '-'
  - Internal '/' is allowed (example: api/login)

Examples:
  git feat login
  git feat login --push
  git feat api/login
  git fix issue-123
  git fix issue-123 --push
  git sync
  git sync --push
  git pr
EOF
}

# --- Configuration ---
BRANCH_TYPES="feature bugfix hotfix"
CREATE_USAGE_HINT="Use: git feat <name>, git fix <name> or git hotfix <name>. Quote names with spaces."

# --- Shared Functions ---
error() {
	printf '❌ Error: %s\n' "$1" >&2
	exit 1
}
create_usage_error() {
	error "$1. ${CREATE_USAGE_HINT}"
}
warn() { printf ' ⚠ Warning: %s\n' "$1" >&2; }
info() { printf ' → %s\n' "$1" >&2; }
ok() { printf '✔ %s\n' "$1" >&2; }

current_branch() {
	git symbolic-ref --quiet --short HEAD 2>/dev/null || :
}

get_branch_name() {
	local branch
	branch="$(current_branch)"
	[[ -n ${branch} ]] || error "Cannot detect current branch (not a git repo or HEAD is detached)"

	printf '%s\n' "${branch}"
}

validate_prefix() {
	local branch=$1
	local type="${branch%%/*}"
	local allowed_list="${BRANCH_TYPES// /, }"

	for allowed in ${BRANCH_TYPES}; do
		[[ ${type} == "${allowed}" ]] && return 0
	done

	error "Branch must start with one of: ${allowed_list}"
}

detect_base() {
	local branch=$1
	local type="${branch%%/*}"

	case "${type}" in
	hotfix) echo main ;;
	*) echo develop ;;
	esac
}

ensure_local_branch_does_not_exist() {
	local branch=$1
	local parent="${branch%/*}"
	local descendants

	if git show-ref --verify --quiet "refs/heads/${branch}"; then
		error "Local branch '${branch}' already exists"
	fi

	while [[ -n ${parent} && ${parent} != "${branch}" ]]; do
		if git show-ref --verify --quiet "refs/heads/${parent}"; then
			error "Cannot create local branch '${branch}' because '${parent}' already exists"
		fi

		[[ ${parent} == */* ]] || break
		parent="${parent%/*}"
	done

	descendants=$(git for-each-ref --format='%(refname:short)' "refs/heads/${branch}/*")
	[[ -z ${descendants} ]] ||
		error "Cannot create local branch '${branch}' because nested local branches already exist under it"
}

ensure_base_branch_exists() {
	local base=$1

	git show-ref --verify --quiet "refs/remotes/origin/${base}" ||
		error "Base branch 'origin/${base}' was not found"
}

ensure_remote_branch_does_not_exist() {
	local branch=$1
	local parent="${branch%/*}"
	local descendants

	if git show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
		error "Remote branch '${branch}' already exists on origin"
	fi

	while [[ -n ${parent} && ${parent} != "${branch}" ]]; do
		if git show-ref --verify --quiet "refs/remotes/origin/${parent}"; then
			error "Cannot create remote branch '${branch}' because '${parent}' already exists on origin"
		fi

		[[ ${parent} == */* ]] || break
		parent="${parent%/*}"
	done

	descendants=$(git for-each-ref --format='%(refname:short)' "refs/remotes/origin/${branch}/*")
	[[ -z ${descendants} ]] ||
		error "Cannot create remote branch '${branch}' because nested remote branches already exist under it"
}

get_worktree_status() {
	git status --porcelain=1 --untracked-files=normal
}

ensure_no_unmerged_paths() {
	local unmerged_paths=""

	unmerged_paths="$(git ls-files -u)" ||
		error "Could not inspect repository conflicts"

	[[ -z ${unmerged_paths} ]] ||
		error "Repository has conflicts/unmerged paths. Run 'git status', resolve them, then try again."
}

ensure_no_git_operation_in_progress() {
	local rebase_apply="" rebase_merge=""

	if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
		error "A merge is in progress. Run 'git status', then finish or abort it before using git-flow."
	fi

	if git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1; then
		error "A cherry-pick is in progress. Run 'git status', then finish or abort it before using git-flow."
	fi

	if git rev-parse -q --verify REVERT_HEAD >/dev/null 2>&1; then
		error "A revert is in progress. Run 'git status', then finish or abort it before using git-flow."
	fi

	rebase_apply="$(git rev-parse --git-path rebase-apply 2>/dev/null || true)"
	rebase_merge="$(git rev-parse --git-path rebase-merge 2>/dev/null || true)"
	if [[ -n ${rebase_apply} && -d ${rebase_apply} ]] ||
		[[ -n ${rebase_merge} && -d ${rebase_merge} ]]; then
		error "A rebase or patch apply is in progress. Run 'git status', then finish or abort it before using git-flow."
	fi
}

ensure_repository_ready_for_flow() {
	ensure_no_git_operation_in_progress
	ensure_no_unmerged_paths
}

create_autostash() {
	local label=$1
	local stash_before stash_after

	stash_before=$(git rev-parse -q --verify refs/stash 2>/dev/null || true)

	info "Stashing local changes…"
	if ! git stash push -u -m "${label}" >/dev/null; then
		warn "Local changes could not be auto-stashed."
		warn "The command stopped before switching branches."
		warn "Review the current state with: git status"
		warn "If Git reports unmerged paths, resolve them before trying again."
		error "Failed to stash local changes"
	fi

	stash_after=$(git rev-parse -q --verify refs/stash 2>/dev/null || true)

	[[ -n ${stash_after} && ${stash_after} != "${stash_before}" ]] ||
		error "Expected an auto-stash to be created, but none was found"

	printf '%s\n' 'stash@{0}'
}

find_stash_ref_by_label() {
	local label=$1
	local ref subject
	local stash_entries=""

	[[ -n ${label} ]] || return 0

	stash_entries="$(git stash list --format='%gd%x09%gs')" || return 0
	[[ -n ${stash_entries} ]] || return 0

	while IFS=$'\t' read -r ref subject; do
		if [[ ${subject} == *"${label}"* ]]; then
			printf '%s\n' "${ref}"
			return 0
		fi
	done <<< "${stash_entries}"

	return 0
}

print_autostash_recovery_guidance() {
	local stash_label=${1-}
	local recovery_ref="" quoted_label=""

	recovery_ref="$(find_stash_ref_by_label "${stash_label}")"
	if [[ -n ${stash_label} ]]; then
		printf -v quoted_label '%q' "${stash_label}"
	fi

	warn "Auto-stash could not be restored automatically."
	if [[ -n ${recovery_ref} ]]; then
		warn "Your changes were kept in the stash list. Inspect them with: git stash show --stat --include-untracked ${recovery_ref}"
	else
		warn "Your changes were kept in the stash list."
	fi
	warn "Review the current state with: git status"
	warn "If git status already shows your changes, do not apply the stash again."
	if [[ -n ${recovery_ref} ]]; then
		warn "If your changes are not present, run: git stash apply ${recovery_ref}"
		warn "If apply reports conflicts, resolve them and stage files manually with: git add <files>"
	else
		warn "Find the stash ref with: git stash list --format='%gd %gs'"
		warn "Then apply it with: git stash apply <stash-ref>"
		warn "If apply reports conflicts, resolve them and stage files manually with: git add <files>"
	fi
	if [[ -n ${stash_label} ]]; then
		warn "If the stash ref changes later, find it with: git stash list --format='%gd %gs' | grep -F -- ${quoted_label}"
	fi
}

restore_autostash() {
	local stash_ref=$1
	local stash_label=${2-}

	[[ -n ${stash_ref} ]] || return 0

	info "Restoring stashed local changes…"
	if git stash pop --index "${stash_ref}"; then
		info "Restored local changes"
		return 0
	fi

	print_autostash_recovery_guidance "${stash_label}"
	error "Failed to restore auto-stashed changes"
}

rollback_create() {
	local original_branch=$1
	local stash_ref=${2-}
	local stash_label=${3-}
	local returned_to_original=false

	warn "Branch creation failed. Attempting to restore previous state…"

	if [[ -n ${original_branch} ]]; then
		if git checkout "${original_branch}" >/dev/null 2>&1; then
			returned_to_original=true
			info "Returned to '${original_branch}'"
		else
			warn "Could not switch back to '${original_branch}'"
		fi
	else
		warn "Original context was detached HEAD; skipping automatic branch restore"
	fi

	if [[ -n ${stash_ref} ]]; then
		if ${returned_to_original}; then
			info "Restoring stashed local changes to '${original_branch}'…"
			if git stash pop --index "${stash_ref}" >/dev/null 2>&1; then
				info "Restored local changes to '${original_branch}'"
			else
				print_autostash_recovery_guidance "${stash_label}"
			fi
		else
			print_autostash_recovery_guidance "${stash_label}"
		fi
	fi
}

validate_branch_name_input() {
	local name=$1

	[[ -n ${name} ]] || error "Branch name cannot be empty"
	[[ ${name} != /* ]] || error "Branch name cannot start with '/'"
	[[ ${name} != */ ]] || error "Branch name cannot end with '/'"
	[[ ${name} != *"//"* ]] || error "Branch name cannot contain consecutive '/'"
}

normalize_branch_name() {
	local name=$1

	name="${name#"${name%%[![:space:]]*}"}"
	name="${name%"${name##*[![:space:]]}"}"

	[[ -n ${name} ]] || error "Branch name cannot be empty"

	name="${name// /-}"

	while [[ ${name} == *"--"* ]]; do
		name="${name//--/-}"
	done

	printf '%s\n' "${name}"
}

validate_branch_ref() {
	local branch=$1

	git check-ref-format --branch "${branch}" >/dev/null 2>&1 ||
		error "Invalid branch name '${branch}'"
}

fetch_prune() {
	info "Fetching and pruning origin…"
	git fetch --prune origin
}

conditional_push() {
	local branch=$1 do_push=$2 action=$3
	if ${do_push}; then
		info "Pushing '${branch}'…"
		git push --force-with-lease origin "${branch}" || error "Push failed for branch '${branch}'"
		ok "${action} and pushed '${branch}'"
	else
		ok "${action} '${branch}'"
	fi
}

# --- Commands ---
cmd_sync() {
	local do_push=false
	if [[ ${1-} == "--push" ]]; then
		do_push=true
		shift
	fi

	[[ $# -eq 0 ]] || error "Usage: git flow sync [--push]"

	local branch base
	branch=$(get_branch_name)
	validate_prefix "${branch}"
	base=$(detect_base "${branch}")

	echo "[GIT-FLOW] Syncing '${branch}' against '${base}'"
	ensure_repository_ready_for_flow
	fetch_prune

	info "Rebasing '${branch}' onto origin/${base}…"
	git rebase "origin/${base}" --autostash || error "Rebase failed; resolve conflicts and run 'git rebase --continue'"

	conditional_push "${branch}" "${do_push}" "Synced"
}

cmd_create() {
	local selector=${1-}
	shift || true

	local do_push=false
	local target_branch="" raw_name="" normalized_name=""
	local original_branch="" stash_ref="" worktree_status="" auto_stash_label=""
	local positional=()

	[[ -n ${selector} ]] || create_usage_error "Missing branch type or name"

	for arg in "$@"; do
		case "${arg}" in
		--push) do_push=true ;;
		-*) create_usage_error "Unknown option '${arg}'" ;;
		*) positional+=("${arg}") ;;
		esac
	done

	if [[ ${selector} == */* ]]; then
		case ${#positional[@]} in
		0) target_branch="${selector}" ;;
		*) create_usage_error "Do not pass extra arguments when using '<type/name>'" ;;
		esac
	else
		case ${#positional[@]} in
		0) create_usage_error "Missing branch name" ;;
		1) raw_name="${positional[0]}" ;;
		*) create_usage_error "Too many arguments" ;;
		esac

		validate_branch_name_input "${raw_name}"
		normalized_name="$(normalize_branch_name "${raw_name}")"
		validate_branch_name_input "${normalized_name}"

		target_branch="${selector}/${normalized_name}"
	fi

	validate_prefix "${target_branch}"
	validate_branch_ref "${target_branch}"

	local base
	base=$(detect_base "${target_branch}")
	original_branch="$(current_branch)"

	echo "[GIT-FLOW] Creating '${target_branch}' from '${base}'"
	ensure_repository_ready_for_flow

	ensure_local_branch_does_not_exist "${target_branch}"

	fetch_prune

	ensure_base_branch_exists "${base}"
	ensure_remote_branch_does_not_exist "${target_branch}"

	worktree_status="$(get_worktree_status)"
	if [[ -n ${worktree_status} ]]; then
		if [[ -n ${original_branch} ]]; then
			auto_stash_label="git-flow:auto-stash:$(date -u +%Y%m%dT%H%M%SZ):${target_branch}:from:${original_branch}"
		else
			auto_stash_label="git-flow:auto-stash:$(date -u +%Y%m%dT%H%M%SZ):${target_branch}"
		fi
		stash_ref=$(create_autostash "${auto_stash_label}")
	fi

	if ! git checkout "${base}"; then
		rollback_create "${original_branch}" "${stash_ref}" "${auto_stash_label}"
		error "Failed to checkout base branch '${base}'"
	fi

	if ! git merge --ff-only "origin/${base}"; then
		rollback_create "${original_branch}" "${stash_ref}" "${auto_stash_label}"
		error "Failed to fast-forward '${base}' to 'origin/${base}'"
	fi

	if ! git checkout -b "${target_branch}"; then
		rollback_create "${original_branch}" "${stash_ref}" "${auto_stash_label}"
		error "Failed to create branch '${target_branch}'"
	fi

	if [[ -n ${stash_ref} ]]; then
		restore_autostash "${stash_ref}" "${auto_stash_label}"
	fi

	conditional_push "${target_branch}" "${do_push}" "Created"
}

cmd_propose_azure() {
	local branch base_url remote_url url target_ref

	branch=$(get_branch_name)
	echo "[GIT-FLOW] Generating PR creation URL for '${branch}'…"

	base_url=""
	if command -v az >/dev/null 2>&1 &&
		base_url=$(az repos show --detect --output tsv --query webUrl 2>/dev/null); then
		:
	fi

	if [[ -z ${base_url} ]]; then
		remote_url=$(git remote get-url origin 2>/dev/null) || error "Could not get remote URL from 'origin'"

		if [[ ${remote_url} =~ ^git@ssh\.dev\.azure\.com:v3/([^/]+)/([^/]+)/([^/]+)(\.git)?$ ]]; then
			base_url="https://dev.azure.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/_git/${BASH_REMATCH[3]}"
		elif [[ ${remote_url} =~ ^https://dev.azure.com/([^/]+)/([^/]+)/_git/([^/]+)(\.git)?$ ]]; then
			base_url="https://dev.azure.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/_git/${BASH_REMATCH[3]}"
		else
			error "Could not detect Azure DevOps repository from '${remote_url}'"
		fi
	fi

	target_ref=$(detect_base "${branch}")
	url="${base_url%/}/pullrequestcreate?sourceRef=${branch}&targetRef=${target_ref}"

	xdg-open "${url}" >/dev/null 2>&1 ||
		open "${url}" >/dev/null 2>&1 ||
		ok "Open this URL in your browser: ${url}"
}

# --- Dispatcher ---
cmd=${1-}
shift || true

case "${cmd}" in
"")
	show_help
	;;
--help | help)
	show_help
	;;
sync)
	cmd_sync "$@"
	;;
propose | pr)
	cmd_propose_azure
	;;
*)
	for type in ${BRANCH_TYPES}; do
		if [[ ${cmd} == "${type}" ]]; then
			cmd_create "${type}" "$@"
			exit
		elif [[ ${cmd} == "${type}/"* ]]; then
			cmd_create "${cmd}" "$@"
			exit
		fi
	done

	warn "Unknown command '${cmd}'. Run 'git flow' or 'git flow help'."
	exit 1
	;;
esac
